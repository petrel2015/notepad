{
  "name": "notepad-browser",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "preview": "vite preview --host 127.0.0.1",
    "format": "prettier --write \"src/**/*.{ts,json,css}\" \"tests/**/*.ts\" package.json tsconfig.json index.html",
    "format:check": "prettier --check \"src/**/*.{ts,json,css}\" \"tests/**/*.ts\" package.json tsconfig.json index.html",
    "build:extension": "tsc --noEmit && node scripts/build-extension.mjs",
    "check:extension": "node scripts/check-extension.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "^6.8.0",
    "@codemirror/lang-json": "^6.0.1",
    "@codemirror/language": "^6.11.0",
    "@codemirror/merge": "^6.10.0",
    "@codemirror/state": "^6.5.0",
    "@codemirror/view": "^6.36.0",
    "@lezer/highlight": "^1.2.1",
    "jsonc-parser": "^3.3.1"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.7",
    "@types/node": "^26.6.5",
    "prettier": "^3.9.10",
    "typescript": "^5.8.0",
    "vite": "^6.1.0",
    "vitest": "^3.2.0"
  }
}
